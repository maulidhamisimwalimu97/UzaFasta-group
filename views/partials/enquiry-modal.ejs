<style>
        .uzafasta-enquiry-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(90deg, #0E8EE2, #0772BD);
            color: #fff;
            font-weight: 600;
            font-size: 15px;
            padding: 13px 28px;
            border-radius: 50px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: transform .25s ease, box-shadow .25s ease;
            box-shadow: 0 8px 22px rgba(14, 142, 226, .28);
        }
        .uzafasta-enquiry-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(14, 142, 226, .38);
            color: #fff;
        }
        .uzafasta-enquiry-btn i { transition: transform .25s ease; }
        .uzafasta-enquiry-btn:hover i { transform: translateX(4px); }
        .uzafasta-enquiry-note {
            font-size: 13px;
            color: #7c8698;
            margin-top: 4px;
        }
        .uzafasta-track-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #0E8EE2;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: color .2s ease;
        }
        .uzafasta-track-link:hover {
            color: #FCB614;
            text-decoration: underline;
        }
        #enquiryModal .modal-dialog { max-width: 460px; }
        #enquiryModal .modal-content {
            border: none;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(15, 45, 110, .18);
        }
        #enquiryModal .modal-header {
            border-bottom: 1px solid #eef1f7;
            padding: 20px 24px 16px;
        }
        #enquiryModal .modal-title { font-weight: 700; color: #0e1c3a; }
        #enquiryModal .modal-body { padding: 22px 24px 6px; }
        #enquiryModal .modal-footer {
            border-top: 1px solid #eef1f7;
            padding: 16px 24px 22px;
        }
        #enquiryModal .form-label {
            font-weight: 600;
            font-size: 14px;
            color: #3a4257;
            margin-bottom: 6px;
        }
        #enquiryModal .form-control,
        #enquiryModal .form-select {
            border-radius: 10px;
            border: 1px solid #dbe1ec;
            padding: 11px 14px;
            font-size: 14.5px;
            color: #2b3350;
        }
        #enquiryModal .form-control:focus,
        #enquiryModal .form-select:focus {
            border-color: #0E8EE2;
            box-shadow: 0 0 0 .2rem rgba(14, 142, 226, .12);
        }
        .uzafasta-enquiry-alert {
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 14.5px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }
        .uzafasta-enquiry-alert.success {
            background: #e8f8ef;
            color: #12794b;
            border: 1px solid #bfe9d0;
        }
        .uzafasta-enquiry-alert.danger {
            background: #fdeeee;
            color: #b02a37;
            border: 1px solid #f3c6c6;
        }
    </style>

    <!--====== Enquiry Modal ======-->
    <div class="modal fade" id="enquiryModal" tabindex="-1" aria-labelledby="enquiryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="enquiryModalLabel">Make an Enquiry</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST" action="/service-enquiry">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="enqName">Full Name *</label>
                            <input type="text" class="form-control" id="enqName" name="name" placeholder="Your full name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="enqEmail">Email Address *</label>
                            <input type="email" class="form-control" id="enqEmail" name="email" placeholder="you@example.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="enqPhone">Phone Number *</label>
                            <input type="tel" class="form-control" id="enqPhone" name="phone" placeholder="e.g. +255 7XX XXX XXX" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="enqService">Service *</label>
                            <select class="form-select" id="enqService" name="service" required>
                                <% if (typeof currentService === 'undefined' || !currentService) { %>
                                    <option value="" selected disabled>Select a service</option>
                                <% } %>
                                <% (typeof services !== 'undefined' ? services : []).forEach(function(s) { %>
                                    <option value="<%= s.name %>" <%= typeof currentService !== 'undefined' && currentService === s.slug ? 'selected' : '' %>><%= s.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <input type="hidden" name="redirect" value="<%= typeof redirectPath !== 'undefined' && redirectPath ? redirectPath : '/services' %>">
                        <p class="uzafasta-enquiry-note"><i class="far fa-info-circle"></i> Our team will get back to you within 24 hours.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="uzafasta-enquiry-btn">Submit Enquiry<i class="far fa-arrow-right"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!--====== Enquiry Success Modal ======-->
    <% if (typeof enquiryMsg !== 'undefined' && enquiryMsg && enquiryMsg.type === 'success') { %>
        <div class="modal fade" id="enquirySuccessModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border:none;border-radius:16px;box-shadow:0 20px 60px rgba(15,45,110,.18);padding:10px;">
                    <div class="modal-body">
                        <div class="text-center py-2">
                            <i class="fas fa-check-circle" style="font-size:52px;color:#1bbf6c;"></i>
                            <h5 style="margin-top:14px;font-weight:700;color:#0e1c3a;font-size:22px;">Enquiry Sent!</h5>
                            <p style="color:#5a6472;font-size:15px;margin:10px 0 4px;"><%= enquiryMsg.text %></p>
                            <p style="color:#8a93a6;font-size:13px;margin:6px 0 14px;">Use your tracking code to follow the progress of your enquiry.</p>
                            <a href="/track" class="uzafasta-enquiry-btn" style="padding:11px 24px;font-size:14px;">Track Enquiry<i class="far fa-arrow-right"></i></a>
                            <button type="button" class="btn mt-2" style="border:none;background:transparent;color:#7c8698;font-weight:500;" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script>
            (function () {
                var m = document.getElementById('enquirySuccessModal');
                if (!m) return;
                window.addEventListener('load', function () {
                    if (window.bootstrap && bootstrap.Modal) {
                        new bootstrap.Modal(m).show();
                    } else if (typeof jQuery !== 'undefined') {
                        jQuery(m).modal('show');
                    }
                });
            })();
        </script>
    <% } %>