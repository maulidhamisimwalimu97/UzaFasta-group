        <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Typewriter effect for hero heading
            var gradientEl = document.querySelector('.hero h1 .gradient-text');
            if (gradientEl) {
                var fullText = gradientEl.textContent.trim();
                gradientEl.textContent = '';
                setTimeout(function() {
                    var i = 0;
                    var typeTimer = setInterval(function() {
                        if (i < fullText.length) {
                            gradientEl.textContent += fullText[i];
                            i++;
                        } else {
                            clearInterval(typeTimer);
                            setTimeout(function() {
                                gradientEl.style.borderRight = 'none';
                            }, 2000);
                        }
                    }, 80);
                }, 800);
            }

            // Counter animation for stats
            var counters = [
                { id: 'stat1', target: 150, suffix: '+' },
                { id: 'stat2', target: 100, suffix: '+' },
                { id: 'stat3', target: 25,  suffix: '+' },
                { id: 'stat4', target: 99,  suffix: '%' }
            ];
            counters.forEach(function(c) {
                var el = document.getElementById(c.id);
                if (!el) return;
                var current = 0;
                var increment = Math.max(1, Math.floor(c.target / 60));
                var timer = setInterval(function() {
                    current += increment;
                    if (current >= c.target) {
                        current = c.target;
                        clearInterval(timer);
                    }
                    el.textContent = current + c.suffix;
                }, 25);
            });

            // Brands Slider
            var brandsSlider = $('.uzafasta-brands-slider');
            if (brandsSlider.length && typeof $.fn.slick !== 'undefined') {
                brandsSlider.slick({
                    slidesToShow: 5,
                    slidesToScroll: 1,
                    autoplay: true,
                    autoplaySpeed: 2000,
                    speed: 800,
                    arrows: false,
                    dots: true,
                    pauseOnHover: true,
                    responsive: [
                        {
                            breakpoint: 1200,
                            settings: { slidesToShow: 4 }
                        },
                        {
                            breakpoint: 992,
                            settings: { slidesToShow: 3 }
                        },
                        {
                            breakpoint: 768,
                            settings: { slidesToShow: 2 }
                        },
                        {
                            breakpoint: 480,
                            settings: { slidesToShow: 1 }
                        }
                    ]
                });
            }

            // Portfolio Filter Tabs
            $('.portfolio-tab').on('click', function() {
                var filter = $(this).data('filter');
                $('.portfolio-tab').removeClass('active');
                $(this).addClass('active');
                $('.portfolio-card').each(function() {
                    if (filter === 'all' || $(this).data('category') === filter) {
                        $(this).removeClass('hidden');
                    } else {
                        $(this).addClass('hidden');
                    }
                });
            });
        });
        </script>
