                    <div class="portfolio-grid" data-aos="fade-up">
                        <% var pfPalettes = { website: ['linear-gradient(135deg, #1B2A4A, #2D4A7A)', '🌐'], software: ['linear-gradient(135deg, #0F172A, #1E3A5F)', '💻'], branding: ['linear-gradient(135deg, #4A1942, #7B2D8E)', '🎨'], video: ['linear-gradient(135deg, #1a1a2e, #16213e)', '🎬'], marketing: ['linear-gradient(135deg, #0D3B66, #1D6FA5)', '📊'] }; %>
                        <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
                            <% projects.forEach(function(p, idx) { %>
                                <% var pf = pfPalettes[p.filterKey] || ['linear-gradient(135deg, #2D1B4E, #5B3A8C)', '🛒']; %>
                                <div class="portfolio-card" data-category="<%= p.filterKey %>" style="background: <%= pf[0] %>;">
                                    <div class="portfolio-card-bg"><%= pf[1] %></div>
                                    <div class="portfolio-card-overlay">
                                        <span class="portfolio-card-tag"><%= p.category %></span>
                                        <h3><%= p.title %></h3>
                                        <p><%= p.description || 'Click to view this project.' %></p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center w-100 py-5">
