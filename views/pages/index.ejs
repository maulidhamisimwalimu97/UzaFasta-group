<script src="assets/js/theme.js"></script>
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Typewriter effect for hero heading
            var gradientEl = document.querySelector('.hero h1 .gradient-text');
            if (gradientEl) {
                var fullText = gradientEl.textContent.trim();
                gradientEl.textContent = '';
                setTimeout(function() {
                    var i = 0;
                    var typeTimer = setInterval(function() {
                        if (i < fullText.length) {
                            gradientEl.textContent += fullText[i];
                            i++;
                        } else {
                            clearInterval(typeTimer);
                            setTimeout(function() {
                                gradientEl.style.borderRight = 'none';
                            }, 2000);
                        }
                    }, 80);
                }, 800);
            }

            // Counter animation for stats
            var counters = [
                { id: 'stat1', target: 150, suffix: '+' },
                { id: 'stat2', target: 100, suffix: '+' },
                { id: 'stat3', target: 25,  suffix: '+' },
                { id: 'stat4', target: 99,  suffix: '%' }
            ];
            counters.forEach(function(c) {
                var el = document.getElementById(c.id);
                if (!el) return;
                var current = 0;
                var increment = Math.max(1, Math.floor(c.target / 60));
                var timer = setInterval(function() {
                    current += increment;
                    if (current >= c.target) {
                        current = c.target;
                        clearInterval(timer);
                    }
                    el.textContent = current + c.suffix;
                }, 25);
            });
        });
        </script>
    <!--====== Scroll to Top ======-->
    <button class="uzafasta-scroll-top" id="scrollTopBtn" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script>
        (function() {
            var btn = document.getElementById('scrollTopBtn');
            if (!btn) return;
            function toggle() {
                if (window.scrollY > 400 || document.documentElement.scrollTop > 400) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
            window.addEventListener('scroll', toggle);
            btn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();
    </script>
