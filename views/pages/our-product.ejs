        <!--====== Aos css ======-->
        <link rel="stylesheet" href="assets/css/plugins/aos.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="assets/css/spacings.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="assets/css/style.css">
        <style>
            .uzafasta-product-box {
                background: #fff;
                border: 1px solid #eef1f7;
                border-radius: 18px;
                padding: 40px 38px;
                box-shadow: 0 14px 40px rgba(15, 45, 110, 0.08);
                height: 100%;
                transition: transform .3s ease, box-shadow .3s ease;
            }
            .uzafasta-product-box:hover {
                transform: translateY(-6px);
                box-shadow: 0 22px 50px rgba(14, 142, 226, 0.14);
            }
            .uzafasta-product-icon {
                width: 72px;
                height: 72px;
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 30px;
                color: #fff;
                background: linear-gradient(135deg, #0E8EE2, #0772BD);
                margin-bottom: 22px;
            }
            .uzafasta-product-box h3 {
                color: #0e1c3a;
                font-size: 24px;
                margin-bottom: 14px;
            }
            .uzafasta-product-box p {
                color: #5a6472;
                font-size: 15px;
                line-height: 1.7;
                margin-bottom: 18px;
            }
            .uzafasta-product-box ul {
                margin: 0 0 24px;
                padding: 0;
                list-style: none;
            }
            .uzafasta-product-box ul li {
                color: #3a4257;
                font-size: 15px;
                margin-bottom: 10px;
            }
            .uzafasta-product-box ul li i {
                color: #1bbf6c;
                margin-right: 9px;
            }
            .uzafasta-product-cta {
                background: linear-gradient(135deg, #0E8EE2, #0772BD);
                border-radius: 18px;
                padding: 46px 40px;
                text-align: center;
                color: #fff;
            }
            .uzafasta-product-cta h2 {
                color: #fff;
                font-size: 28px;
                margin-bottom: 10px;
            }
            .uzafasta-product-cta p {
                color: rgba(255,255,255,.85);
                margin-bottom: 22px;
            }
        </style>
    </head>
    <body class="axis-innerpage">
        <!--====== Start Preloader ======-->
        <div class="preloader">
            <div class="loading-wrapper">
                <div class="loading"></div>
                <div id="loading-icon"><img src="assets/images/loader.png" alt="loader"></div>
            </div>
        </div><!--====== End Preloader ======-->
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <%- include('../partials/header') %>
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <main>
                    <!--======  Start Page Hero Section  ======-->
                    <section class="page-hero bg_cover p-r z-1" data-src="assets/images/innerpage/bg/services-bg.jpg">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <!--=== Page Content ===-->
                                    <div class="page-content text-center">
                                        <h1>Our Products</h1>
                                        <ul>
                                            <li><a href="/">Home</a></li>
                                            <li>Our Products</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section><!--======  End Page Hero Section  ======-->

                    <!--======  Start Products Section  ======-->
                    <section class="pt-115 pb-100">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <div class="section-title text-center mb-55">
                                        <span class="sub-title" data-aos="fade-down" data-aos-duration="1000">
                                            <span class="line"></span>
                                            Our Products
                                        </span>
                                        <h2>Ready-Made Solutions Built by Uzafasta Group</h2>
                                        <p class="sf-intro">Powerful, ready-to-use products that help Tanzanian businesses go online fast and grow.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="row gy-4 justify-content-center">

                                <!--====== Hosting ======-->
                                <div class="col-lg-6" id="hosting">
                                    <div class="uzafasta-product-box" data-aos="fade-up" data-aos-duration="1000">
                                        <div class="uzafasta-product-icon"><i class="fas fa-cloud"></i></div>
                                        <h3>Hosting</h3>
                                        <p>Fast, reliable web hosting that keeps your website online and loading quickly, with full local support from our team.</p>
                                        <ul>
                                            <li><i class="fas fa-check-circle"></i> Fast SSD hosting with 99.9% uptime</li>
                                            <li><i class="fas fa-check-circle"></i> Free SSL certificate on every plan</li>
                                            <li><i class="fas fa-check-circle"></i> Easy domain registration &amp; management</li>
                                            <li><i class="fas fa-check-circle"></i> Daily backups and security monitoring</li>
                                            <li><i class="fas fa-check-circle"></i> 24/7 local support in Swahili &amp; English</li>
                                        </ul>
                                        <a href="#" class="uzafasta-enquiry-btn" data-bs-toggle="modal" data-bs-target="#enquiryModal">Get Hosting <i class="far fa-arrow-right"></i></a>
                                    </div>
                                </div>

                                <!--====== Uzafasta E-Commerce ======-->
                                <div class="col-lg-6" id="uzafasta-ecommerce">
                                    <div class="uzafasta-product-box" data-aos="fade-up" data-aos-duration="1100">
                                        <div class="uzafasta-product-icon"><i class="fas fa-cart-plus"></i></div>
                                        <h3>Uzafasta E-Commerce</h3>
                                        <p>Our own e-commerce platform that lets you open an online store quickly, accept mobile money, and manage orders easily.</p>
                                        <ul>
                                            <li><i class="fas fa-check-circle"></i> Ready online store in days, not months</li>
                                            <li><i class="fas fa-check-circle"></i> Mobile money &amp; card payments built in</li>
                                            <li><i class="fas fa-check-circle"></i> Order and inventory management</li>
                                            <li><i class="fas fa-check-circle"></i> Dashboard you can manage yourself</li>
                                            <li><i class="fas fa-check-circle"></i> Store setup and team training included</li>
                                        </ul>
                                        <a href="#" class="uzafasta-enquiry-btn" data-bs-toggle="modal" data-bs-target="#enquiryModal">Start Selling With Uzafasta <i class="far fa-arrow-right"></i></a>
                                    </div>
                                </div>

                            </div>

                            <!--====== CTA ======-->
                            <div class="uzafasta-product-cta mt-60" data-aos="fade-up" data-aos-duration="1000">
                                <h2>Ready to get started?</h2>
                                <p>Talk to our team and we will help you choose the right product for your business.</p>
                                <a href="#" class="uzafasta-enquiry-btn" style="background:#fff;color:#0E8EE2;" data-bs-toggle="modal" data-bs-target="#enquiryModal">Make an Enquiry <i class="far fa-arrow-right"></i></a>
                                <a href="/contact" class="uzafasta-svc-cta-btn" style="margin-left:10px;">Contact Us <i class="far fa-arrow-right"></i></a>
                            </div>

                        </div>
                    </section><!--======  End Products Section  ======-->
                </main>
                <%- include('../partials/footer') %>
            </div>
        </div>
        <!-- Scroll to Top Button (outside smooth-wrapper) -->
        <button class="uzafasta-scroll-top" id="scrollTopBtn" aria-label="Back to top">
            <i class="fas fa-arrow-up"></i>
        </button>
        <script>
            (function () {
                var btn = document.getElementById('scrollTopBtn');
                if (!btn) return;
                function toggle() {
                    if (window.scrollY > 400 || document.documentElement.scrollTop > 400) {
                        btn.classList.add('show');
                    } else {
                        btn.classList.remove('show');
                    }
                }
                window.addEventListener('scroll', toggle);
                btn.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            })();
        </script>
