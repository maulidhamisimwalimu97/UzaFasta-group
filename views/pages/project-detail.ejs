<!DOCTYPE html>
<html lang="zxx">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="description" content="UzaFasta Group Project">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title><%= project.title %> - UzaFasta Group</title>
        <link rel="icon" href="/assets/images/favicon.png" type="image/png">
        <link rel="shortcut icon" href="/assets/images/favicon.png" type="image/png">
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/assets/fonts/fontawesome/css/all.min.css">
        <link rel="stylesheet" href="/assets/css/plugins/bootstrap.min.css">
        <link rel="stylesheet" href="/assets/css/plugins/slick.css">
        <link rel="stylesheet" href="/assets/css/plugins/magnific-popup.css">
        <link rel="stylesheet" href="/assets/css/plugins/aos.css">
        <link rel="stylesheet" href="/assets/css/spacings.css">
        <link rel="stylesheet" href="/assets/css/style.css">
        <style> .project-body { white-space: pre-wrap; line-height: 1.9; font-family: 'Times New Roman', Times, serif; text-align: justify; font-size: 18px; } </style>
    </head>
    <body class="axis-innerpage">
        <!--====== Start Preloader ======-->
        <div class="preloader">
            <div class="loading-wrapper">
                <div class="loading"></div>
                <div id="loading-icon"><img src="/assets/images/loader.png" alt="loader"></div>
            </div>
        </div><!--====== End Preloader ======-->
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <%- include('../partials/header') %>
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <main>
            <section class="page-hero bg_cover p-r z-1" data-src="/assets/images/innerpage/bg/projects-bg.jpg">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="page-content text-center">
                                <h1><%= project.title %></h1>
                                <ul>
                                    <li><a href="/index">Home</a></li>
                                    <li><a href="/projects">Portfolio</a></li>
                                    <li><%= project.title %></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section class="pt-120 pb-120">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-9 col-lg-10">
                            <div class="mb-40" data-aos="fade-up" data-aos-duration="1000">
                                <% if (project.video_url) {
                                    const vu = project.video_url;
                                    const isYouTube = vu.includes('youtube.com') || vu.includes('youtu.be');
                                    const isVimeo   = vu.includes('vimeo.com');
                                    let embedUrl = vu;
                                    if (isYouTube) {
                                        let vid = '';
                                        if (vu.includes('youtu.be/')) vid = vu.split('youtu.be/')[1].split(/[?&]/)[0];
                                        else vid = new URL(vu).searchParams.get('v');
                                        embedUrl = 'https://www.youtube.com/embed/' + vid + '?rel=0';
                                    } else if (isVimeo) {
                                        const parts = vu.split('/');
                                        embedUrl = 'https://player.vimeo.com/video/' + parts[parts.length - 1] + '?byline=0&portrait=0';
                                    }
                                %>
                                <div class="project-thumbnail mb-30">
                                    <% if (isYouTube || isVimeo) { %>
                                        <div class="embed-responsive embed-responsive-16by9">
                                            <iframe class="embed-responsive-item" src="<%= embedUrl %>" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                        </div>
                                    <% } else { %>
                                        <div style="width:100%;border-radius:12px;overflow:hidden;background:#000;">
                                                    <video controls preload="metadata" style="width:100%;aspect-ratio:16/9;object-fit:contain;background:#000;display:block;"<% if (project.videoPoster) { %> poster="<%= project.videoPoster %>"<% } %>>
                                                    <source src="<%= vu %>" type="video/<%= project.videoType %>">
                                                    Your browser does not support the video tag.
                                            </video>
                                        </div>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <div class="project-thumbnail mb-30">
                                    <img src="<%= project.cover_image || '/assets/images/innerpage/project/project-img1.png' %>" alt="<%= project.title %>" style="width:100%;height:auto;border-radius:12px;">
                                </div>
                            <% } %>
                                <div class="d-flex flex-wrap align-items-center mb-30">
                                    <a href="/projects" class="tag badg theme-badge" style="background:#f0f4ff;color:#2d7ff2;padding:6px 16px;border-radius:20px;font-size:14px;font-weight:600;"><%= project.category %></a>
                                    <% if (project.client) { %>
                                        <span class="ml-3 text-muted"><i class="far fa-user mr-1"></i>Client: <%= project.client %></span>
                                    <% } %>
                                </div>
                                <h1 class="mb-3"><%= project.title %></h1>
                                <div class="project-body"><%= project.description.replace(/\n/g, '<br>') %></div>
                                <% if (project.link) { %>
                                    <a href="<%= project.link %>" target="_blank" class="theme-btn style-one mt-30"><i class="far fa-external-link mr-1"></i>Visit Project</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
                <%- include('../partials/footer') %>
            </div>
        </div>
            <!-- Scroll to Top Button (outside smooth-wrapper) -->
    <button class="uzafasta-scroll-top" id="scrollTopBtn" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <script>
        (function () {
            var btn = document.getElementById('scrollTopBtn');
            if (!btn) return;
            function toggle() {
                if (window.scrollY > 400 || document.documentElement.scrollTop > 400) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
            window.addEventListener('scroll', toggle);
            btn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();
    </script>
        <script src="/assets/js/plugins/jquery-3.7.1.min.js"></script>
        <script src="/assets/js/plugins/popper.min.js"></script>
        <script src="/assets/js/plugins/bootstrap.min.js"></script>
        <script src="/assets/js/plugins/gsap/gsap.min.js"></script>
        <script src="/assets/js/plugins/gsap/SplitText.min.js"></script>
        <script src="/assets/js/plugins/gsap/ScrollSmoother.min.js"></script>
        <script src="/assets/js/plugins/gsap/ScrollTrigger.min.js"></script>
        <script src="/assets/js/plugins/slick.min.js"></script>
        <script src="/assets/js/plugins/jquery.magnific-popup.min.js"></script>
        <script src="/assets/js/plugins/jquery.waypoints.js"></script>
        <script src="/assets/js/plugins/jquery.counterup.min.js"></script>
        <script src="/assets/js/plugins/aos.js"></script>
        <script src="/assets/js/theme.js"></script>
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('video[controls]').forEach(function(vid) {
                if (vid.poster) return;
                vid.addEventListener('loadeddata', function() { this.currentTime = 0.05; });
                vid.addEventListener('seeked', function() {
                    if (this.readyState >= 2 && !this.poster) {
                        try {
                            var c = document.createElement('canvas');
                            c.width = this.videoWidth; c.height = this.videoHeight;
                            c.getContext('2d').drawImage(this, 0, 0);
                            this.poster = c.toDataURL('image/jpeg', 0.6);
                        } catch(e) {}
                    }
                });
            });
        });
        </script>
    </body>
</html>