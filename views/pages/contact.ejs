                                    <!-- Contact Wrapper -->
                                    <div class="axis-contact-wrapper" data-aos="fade-up" data-aos-duration="1800">
                                        <h4>Send Us message</h4>
                                        <form>
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="text" class="form_control" placeholder="Full Name*" name="name" required>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="email" class="form_control" placeholder="Email Address*" name="email" required>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="text" class="form_control" placeholder="Company Name*" name="cname" required>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <textarea name="message" placeholder="Write Your Message Here" rows="5" class="form_control"></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <button class="theme-btn style-one">Send A Request<i class="far fa-arrow-right"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="contact-map-sec" data-aos="fade-up" data-aos-duration="1000">
