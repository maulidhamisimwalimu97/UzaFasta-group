<!DOCTYPE html>
<html lang="zxx">
    <head>
        <!--====== Required meta tags ======-->
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="description" content="AI, Agency, Technology">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <!--====== Title ======-->
        <title>UzaFasta-Group</title>
        <!--====== Favicon Icon ======-->
        <link rel="icon" href="assets/images/favicon.png" type="image/png">
        <link rel="shortcut icon" href="assets/images/favicon.png" type="image/png">
        <!--====== Google Fonts ======-->
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
        <!--====== FontAwesome css ======-->
        <link rel="stylesheet" href="assets/fonts/fontawesome/css/all.min.css">
        <!--====== Bootstrap css ======-->
        <link rel="stylesheet" href="assets/css/plugins/bootstrap.min.css">
        <!--====== Slick-popup css ======-->
        <link rel="stylesheet" href="assets/css/plugins/slick.css">
        <!--====== Magnific-popup css ======-->
        <link rel="stylesheet" href="assets/css/plugins/magnific-popup.css">
        <!--====== Aos css ======-->
        <link rel="stylesheet" href="assets/css/plugins/aos.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="assets/css/spacings.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="assets/css/style.css">
    </head>
    <body class="axis-innerpage">
        <!--====== Start Preloader ======-->
        <div class="preloader">
            <div class="loading-wrapper">
                <div class="loading"></div>
                <div id="loading-icon"><img src="assets/images/loader.png" alt="loader"></div>
            </div>
        </div><!--====== End Preloader ======-->
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <%- include('../partials/header') %>
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <main>
                    <!--======  Start Page Hero Section  ======-->
                    <section class="page-hero bg_cover p-r z-1" data-src="assets/images/innerpage/bg/contact-bg.jpg">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <!--=== Page Content ===-->
                                    <div class="page-content text-center">
                                        <h1>Contact Us</h1>
                                        <ul>
                                            <li><a href="/index">Home</a></li>
                                            <li>Contact Us</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section><!--======  End Page Hero Section  ======-->
                    <section class="axis-contact_three pt-120 pb-120">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-xl-7 col-lg-10">
                                    <!-- Fexo Contact Box -->
                                    <div class="axis-contact-box mb-5 mb-xl-0">
                                        <h2 class="text-anm">Contact Information</h2>
                                        <p data-aos="fade-up" data-aos-duration="1000">Get in touch with our team — we're here to help your business grow with technology, creativity and digital strategy.</p>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="axis-info-box style-one mb-30" data-aos="fade-up" data-aos-duration="1000">
                                                    <div class="icon">
                                                        <i class="far fa-map-marker-alt"></i>
                                                    </div>
                                                    <div class="content">
                                                        <h5>Our Address</h5>
                                                        <p>Mbezi Beach Makonde, New Bagamoyo Rd,<br>Dar es Salaam, Tanzania</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="axis-info-box style-one mb-30" data-aos="fade-up" data-aos-duration="1200">
                                                    <div class="icon">
                                                        <i class="far fa-phone-alt"></i>
                                                    </div>
                                                    <div class="content">
                                                        <h5>Contact Number</h5>
                                                        <p><a href="tel:+255678770562">+255 (678) 770 562</a></p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="axis-info-box style-one mb-30" data-aos="fade-up" data-aos-duration="1400">
                                                    <div class="icon">
                                                        <i class="far fa-envelope"></i>
                                                    </div>
                                                    <div class="content">
                                                        <h5>Email Address</h5>
                                                        <p><a href="mailto:info@uzafasta.co.tz">info@uzafasta.co.tz</a></p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="axis-info-box style-one mb-30" data-aos="fade-up" data-aos-duration="1600">
                                                    <div class="icon">
                                                        <i class="far fa-clock"></i>
                                                    </div>
                                                    <div class="content">
                                                        <h5>Working Hours</h5>
                                                        <p>Mon - Sat: 9:00 - 18:00</p>
                                                        <p>Sunday: Closed</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="social-box-wrap" data-aos="fade-up" data-aos-duration="1800">
                                            <h4>Follow The Social Media:</h4>
                                            <p>Connect with Uzafasta Group on social media for updates and insights.</p>
                                            <div class="social-box">
                                                <a href="#"><i class="fab fa-facebook-f"></i></a>
                                                <a href="#"><i class="fab fa-twitter"></i></a>
                                                <a href="#"><i class="fab fa-linkedin-in"></i></a>
                                                <a href="#"><i class="fab fa-youtube"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-5 col-lg-10">
                                    <!-- Contact Wrapper -->
                                    <div class="axis-contact-wrapper" data-aos="fade-up" data-aos-duration="1800">
                                        <h4>Send Us message</h4>
                                        <% if (typeof contactMsg !== 'undefined' && contactMsg) { %>
                                            <div class="alert alert-<%= contactMsg.type %> mb-4">
                                                <%= contactMsg.text %>
                                                <% if (contactMsg.type === 'success') { %>
                                                    <div style="margin-top:12px;">
                                                        <a href="/track" style="display:inline-flex;align-items:center;gap:8px;background:#0E8EE2;color:#fff;font-weight:600;font-size:14px;padding:11px 22px;border-radius:50px;text-decoration:none;box-shadow:0 6px 16px rgba(14,142,226,.25);"><i class="far fa-route"></i> Track Enquiry<i class="far fa-arrow-right"></i></a>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% } %>
                                        <form method="POST" action="/contact">
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="text" class="form_control" placeholder="Full Name*" name="name" required>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="email" class="form_control" placeholder="Email Address*" name="email" required>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="text" class="form_control" placeholder="Phone Number" name="phone">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <input type="text" class="form_control" placeholder="Subject" name="subject">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <textarea name="message" placeholder="Write Your Message Here" rows="5" class="form_control" required></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <button class="theme-btn style-one" type="submit">Send A Request<i class="far fa-arrow-right"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="contact-map-sec" data-aos="fade-up" data-aos-duration="1000">
                        <!--=== Map Box ===-->
                        <div class="map-box mt-5 mt-xl-0" data-aos="fade-up" data-aos-duration="1200">
                            <iframe src="https://www.google.com/maps?q=Mbezi%20Beach%20Mkonde%2C%20New%20Bagamoyo%20Rd%2C%20Dar%20es%20Salaam%2C%20Tanzania&output=embed" loading="lazy">
                            </iframe>
                        </div>
                    </section>
                </main>
                                <%- include('../partials/footer') %>
            </div>
        </div>
            <!-- Scroll to Top Button (outside smooth-wrapper) -->
    <button class="uzafasta-scroll-top" id="scrollTopBtn" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <script>
        (function () {
            var btn = document.getElementById('scrollTopBtn');
            if (!btn) return;
            function toggle() {
                if (window.scrollY > 400 || document.documentElement.scrollTop > 400) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
            window.addEventListener('scroll', toggle);
            btn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();
    </script>
<!--====== Jquery js ======-->
        <script src="assets/js/plugins/jquery-3.7.1.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script src="assets/js/plugins/popper.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script src="assets/js/plugins/bootstrap.min.js"></script>
        <!--====== Gsap Js ======-->
        <script src="assets/js/plugins/gsap/gsap.min.js"></script>
        <script src="assets/js/plugins/gsap/SplitText.min.js"></script>
        <script src="assets/js/plugins/gsap/ScrollSmoother.min.js"></script>
        <script src="assets/js/plugins/gsap/ScrollTrigger.min.js"></script>
        <!--====== Slick js ======-->
        <script src="assets/js/plugins/slick.min.js"></script>
        <!--====== Magnific js ======-->
        <script src="assets/js/plugins/jquery.magnific-popup.min.js"></script>
        <!--====== Waypoint js ======-->
        <script src="assets/js/plugins/jquery.waypoints.js"></script>
        <!--====== CounterUp js ======-->
        <script src="assets/js/plugins/jquery.counterup.min.js"></script>
        <!--====== Aos js ======-->
        <script src="assets/js/plugins/aos.js"></script>
        <!--====== Common js ======-->
<script src="assets/js/theme.js"></script>
    </body>
</html>