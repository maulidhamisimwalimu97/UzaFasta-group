<!DOCTYPE html>
<html lang="zxx">
    <head>
        <!--====== Required meta tags ======-->
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="description" content="AI, Agency, Technology">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <!--====== Title ======-->
        <title>UzaFasta Blogs - UzaFasta Group</title>
        <!--====== Favicon Icon ======-->
        <link rel="icon" href="assets/images/favicon.png" type="image/png">
        <link rel="shortcut icon" href="assets/images/favicon.png" type="image/png">
        <!--====== Google Fonts ======-->
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
        <!--====== FontAwesome css ======-->
        <link rel="stylesheet" href="assets/fonts/fontawesome/css/all.min.css">
        <!--====== Bootstrap css ======-->
        <link rel="stylesheet" href="assets/css/plugins/bootstrap.min.css">
        <!--====== Slick-popup css ======-->
        <link rel="stylesheet" href="assets/css/plugins/slick.css">
        <!--====== Magnific-popup css ======-->
        <link rel="stylesheet" href="assets/css/plugins/magnific-popup.css">
        <!--====== Aos css ======-->
        <link rel="stylesheet" href="assets/css/plugins/aos.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="assets/css/spacings.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="assets/css/style.css">
        <style>
            .uz-blog-card { background:#fff; border:1px solid #eef1f7; border-radius:14px; overflow:hidden; transition:transform .3s ease, box-shadow .3s ease; height:calc(100% - 40px); display:flex; flex-direction:column; }
            .uz-blog-card:hover { transform:translateY(-8px); box-shadow:0 18px 40px rgba(15,45,110,.14); }
            .uz-blog-card .post-thumbnail { position:relative; overflow:hidden; border-radius:14px 14px 0 0; }
            .uz-blog-card .post-thumbnail img.uz-blog-img { width:100%; aspect-ratio:16/10; object-fit:cover; display:block; transition:transform .5s ease; }
            .uz-blog-card .post-thumbnail video.uz-blog-video { width:100%; aspect-ratio:16/10; object-fit:cover; display:block; background:#000; transition:transform .5s ease; }
            .uz-blog-card:hover .post-thumbnail img.uz-blog-img, .uz-blog-card:hover .post-thumbnail video.uz-blog-video { transform:scale(1.06); }
            .uz-date-badge { position:absolute; bottom:12px; left:12px; background:#123a86; color:#fff; padding:7px 13px; border-radius:8px; font-size:12.5px; font-weight:600; z-index:2; box-shadow:0 6px 16px rgba(10,25,70,.35); }
            .uz-date-badge i { margin-right:4px; }
            .uz-blog-card .post-content { padding:22px 22px 26px; flex:1; display:flex; flex-direction:column; }
            .uz-blog-card .uz-blog-title { font-size:19px; line-height:1.5; margin-bottom:10px; }
            .uz-blog-card .uz-blog-title a { color:#0e1c3a; text-decoration:none; }
            .uz-blog-card .uz-blog-title a:hover { color:#123a86; }
            .uz-blog-excerpt { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; color:#5a6472; font-size:14.5px; line-height:1.75; margin:0 0 16px; }
            .uz-video-badge { position:absolute; top:12px; right:12px; width:44px; height:44px; background:rgba(18,58,134,.85); color:#fff; font-size:20px; border-radius:50%; display:flex; align-items:center; justify-content:center; z-index:2; box-shadow:0 6px 18px rgba(0,0,0,.35); }
            .page-hero::after { background-color:rgba(1,15,52,.62); }
            @media (max-width:767.98px) {
                .uz-blog-card .post-content { padding:18px 18px 22px; }
                .uz-blog-card .uz-blog-title { font-size:17px; }
            }
        </style>
    </head>
    <body class="axis-innerpage">
        <!--====== Start Preloader ======-->
        <div class="preloader">
            <div class="loading-wrapper">
                <div class="loading"></div>
                <div id="loading-icon"><img src="assets/images/loader.png" alt="loader"></div>
            </div>
        </div><!--====== End Preloader ======-->
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <%- include('../partials/header') %>
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <main>
                    <!--======  Start Page Hero Section  ======-->
                    <section class="page-hero bg_cover p-r z-1" data-src="assets/images/innerpage/bg/blog-pen.jpg" style="background-image:url('assets/images/innerpage/bg/blog-pen.jpg');background-size:cover;background-position:center;">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <!--=== Page Content ===-->
                                    <div class="page-content text-center">
                                        <h1>Our Blog</h1>
                                        <ul>
                                            <li><a href="index.html">Home</a></li>
                                            <li>Our Blog</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section><!--======  End Page Hero Section  ======-->
                    <section class="axis-blog-grid-sec pt-120 pb-90">
                        <div class="container">
                            <div class="row">
                                <% if (typeof blogs === 'undefined' || blogs.length === 0) { %>
                                    <div class="col-12">
                                        <div class="text-center py-5">
                                            <i class="far fa-newspaper fa-3x mb-3" style="color:#c9d4ea"></i>
                                            <h4>No blog posts yet</h4>
                                            <p class="text-muted">Check back soon for fresh updates from UzaFasta Group.</p>
                                        </div>
                                    </div>
                                <% } %>
                                <% (typeof blogs !== 'undefined' ? blogs : []).forEach(function(blog) { %>
                                <div class="col-lg-4 col-md-6 col-12">
                                    <article class="axis-blog-post-item style-one mb-40 uz-blog-card">
                                        <div class="post-thumbnail">
                                            <a href="/blogs/<%= blog.slug %>">
                                                <% if (blog.video_url) { %>
                                                    <video class="uz-blog-img uz-blog-video" muted loop playsinline preload="metadata" poster="<%= blog.cover_image || '' %>">
                                                        <source src="<%= blog.video_url %>" type="video/<%= blog.video_url.split('.').pop().split('?')[0] %>">
                                                    </video>
                                                <% } else { %>
                                                    <img src="<%= blog.cover_image || 'assets/images/innerpage/blog/blog-grid1.png' %>" alt="<%= blog.title %>" class="uz-blog-img">
                                                <% } %>
                                            </a>
                                            <span class="uz-date-badge"><i class="far fa-calendar-alt mr-1"></i><%= blog.created_at.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                                            <% if (blog.video_url) { %>
                                                <span class="uz-video-badge"><i class="fas fa-play-circle"></i></span>
                                            <% } %>
                                        </div>
                                        <div class="post-content">
                                            <h4 class="title uz-blog-title"><a href="/blogs/<%= blog.slug %>"><%= blog.title %></a></h4>
                                            <% if (blog.excerpt) { %>
                                                <p class="uz-blog-excerpt"><%= blog.excerpt %></p>
                                            <% } %>
                                            <div class="post-bottom">
                                                <a href="/blogs/<%= blog.slug %>" class="uz-more-link">Read Details<i class="far fa-arrow-right"></i></a>
                                            </div>
                                        </div>
                                    </article>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                    </section>
                </main>
                                <%- include('../partials/footer') %>
            </div>
        </div>
            <!-- Scroll to Top Button (outside smooth-wrapper) -->
    <button class="uzafasta-scroll-top" id="scrollTopBtn" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <script>
        (function () {
            var btn = document.getElementById('scrollTopBtn');
            if (!btn) return;
            function toggle() {
                if (window.scrollY > 400 || document.documentElement.scrollTop > 400) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
            window.addEventListener('scroll', toggle);
            btn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();
    </script>
<!--====== Jquery js ======-->
        <script src="assets/js/plugins/jquery-3.7.1.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script src="assets/js/plugins/popper.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script src="assets/js/plugins/bootstrap.min.js"></script>
        <!--====== Gsap Js ======-->
        <script src="assets/js/plugins/gsap/gsap.min.js"></script>
        <script src="assets/js/plugins/gsap/SplitText.min.js"></script>
        <script src="assets/js/plugins/gsap/ScrollSmoother.min.js"></script>
        <script src="assets/js/plugins/gsap/ScrollTrigger.min.js"></script>
        <!--====== Slick js ======-->
        <script src="assets/js/plugins/slick.min.js"></script>
        <!--====== Magnific js ======-->
        <script src="assets/js/plugins/jquery.magnific-popup.min.js"></script>
        <!--====== Waypoint js ======-->
        <script src="assets/js/plugins/jquery.waypoints.js"></script>
        <!--====== CounterUp js ======-->
        <script src="assets/js/plugins/jquery.counterup.min.js"></script>
        <!--====== Aos js ======-->
        <script src="assets/js/plugins/aos.js"></script>
        <!--====== Common js ======-->
<script src="assets/js/theme.js"></script>
        <script>
                        document.addEventListener('DOMContentLoaded', function() {
            $('.uz-blog-video').each(function() {
                var vid = this;
                var card = $(this).closest('.uz-blog-card');
                function capture() {
                    if (this.videoWidth && this.videoHeight && !this.poster) {
                        try {
                            var c = document.createElement('canvas');
                            c.width = this.videoWidth; c.height = this.videoHeight;
                            c.getContext('2d').drawImage(this, 0, 0);
                            this.poster = c.toDataURL('image/jpeg', 0.7);
                        } catch(e) {}
                    }
                }
                vid.addEventListener('loadeddata', function() { this.currentTime = 0.06; });
                vid.addEventListener('loadedmetRandata', function() { this.load(); });
                vid.addEventListener('seeked', capture);
                card.on('mouseenter', function() { vid.muted = true; vid.play(); });
                card.on('mouseleave', function() { vid.pause(); vid.currentTime = 0.06; });
            });
        });
        </script>
    </body>
</html>