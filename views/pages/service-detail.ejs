<!DOCTYPE html>
<html lang="zxx">
    <head>
        <!--====== Required meta tags ======-->
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="description" content="AI, Agency, Technology">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <!--====== Title ======-->
        <title><%= service.name %> | Uzafasta Group</title>
        <!--====== Favicon Icon ======-->
        <link rel="icon" href="/assets/images/favicon.png" type="image/png">
        <link rel="shortcut icon" href="/assets/images/favicon.png" type="image/png">
        <!--====== Google Fonts ======-->
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
        <!--====== FontAwesome css ======-->
        <link rel="stylesheet" href="/assets/fonts/fontawesome/css/all.min.css">
        <!--====== Bootstrap css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/bootstrap.min.css">
        <!--====== Slick-popup css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/slick.css">
        <!--====== Magnific-popup css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/magnific-popup.css">
        <!--====== Aos css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/aos.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="/assets/css/spacings.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="/assets/css/style.css">
    </head>
    <body class="axis-innerpage">
        <!--====== Start Preloader ======-->
        <div class="preloader">
            <div class="loading-wrapper">
                <div class="loading"></div>
                <div id="loading-icon"><img src="/assets/images/loader.png" alt="loader"></div>
            </div>
        </div><!--====== End Preloader ======-->
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <%- include('../partials/header') %>
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <main>
                    <!--======  Start Page Hero Section  ======-->
                    <section class="page-hero bg_cover p-r z-1" data-src="/assets/images/innerpage/bg/services-bg.jpg">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <!--=== Page Content ===-->
                                    <div class="page-content text-center">
                                        <h1><%= service.name %></h1>
                                        <ul>
                                            <li><a href="/index">Home</a></li>
                                            <li><a href="/services">Services</a></li>
                                            <li><%= service.name %></li>
                                        </ul>
                                        <a href="#" class="uzafasta-enquiry-btn mt-3" data-bs-toggle="modal" data-bs-target="#enquiryModal">Make an Enquiry <i class="far fa-arrow-right"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section><!--======  End Page Hero Section  ======-->
                    <!--======  Start Service Details Section  ======-->
                    <section class="service-details-sec pt-120 pb-90">
                        <div class="container">
                            <% if (typeof enquiryMsg !== 'undefined' && enquiryMsg && enquiryMsg.type === 'danger') { %>
                                <div class="uzafasta-enquiry-alert <%= enquiryMsg.type %>">
                                    <i class="fas fa-exclamation-circle"></i>
                                    <span><%= enquiryMsg.text %></span>
                                </div>
                            <% } %>
                            <div class="row">
                                <div class="col-xl-8 col-lg-8">
                                    <div class="service-item-main mb-60">
                                        <div class="service-thumbnail mb-30">
                                            <img src="<%= service.thumb %>" alt="<%= service.name %>">
                                        </div>
                                        <div class="service-content">
                                            <h4 class="title"><%= service.introTitle %></h4>
                                            <% service.intro.forEach(function(p) { %>
                                                <p><%= p %></p>
                                            <% }); %>
                                            <h3>What’s included</h3>
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <ul class="check-list style-one mb-30 uzafasta-svc-check">
                                                        <% service.highlights.forEach(function(item) { %>
                                                            <li><i class="fas fa-check-circle"></i> <%= item %></li>
                                                        <% }); %>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!--=== Faq Wrapper ===-->
                                    <div class="faq-wrapper mb-60">
                                        <div class="row">
                                            <div class="col-xl-12">
                                                <div class="section-title mb-30">
                                                    <span class="sub-title"><span class="line"></span>FAQ</span>
                                                    <h2>Common Questions</h2>
                                                </div>
                                                <div class="accordion" id="svcFaq">
                                                    <% service.faqs.forEach(function(f, i) { %>
                                                        <div class="accordion-card style-two mb-20">
                                                            <div class="accordion-header">
                                                                <h6 class="accordion-title" data-bs-toggle="collapse" data-bs-target="#svcCollapse<%= i %>" aria-expanded="<%= i === 0 ? 'true' : 'false' %>">
                                                                    <%= f.q %>
                                                                </h6>
                                                            </div>
                                                            <div id="svcCollapse<%= i %>" class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>" data-bs-parent="#svcFaq">
                                                                <div class="accordion-content">
                                                                    <p><%= f.a %></p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--=== Sidebar Wrapper ===-->
                                <div class="col-xl-4 col-lg-4">
                                    <div class="uzafasta-svc-sidebar">
                                        <div class="uzafasta-svc-widget mb-30">
                                            <h4>All Services</h4>
                                            <ul class="uzafasta-svc-list">
                                                <% services.forEach(function(s) { %>
                                                    <li class="<%= s.slug === service.slug ? 'active' : '' %>">
                                                        <a href="/services/<%= s.slug %>">
                                                            <i class="fas <%= s.icon %>"></i> <%= s.name %>
                                                            <i class="far fa-arrow-right"></i>
                                                        </a>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                        <div class="uzafasta-svc-cta">
                                            <div class="uzafasta-svc-cta-icon"><i class="fas fa-headset"></i></div>
                                            <h4>Need help with <%= service.name %>?</h4>
                                            <p>Talk to our team and get a free consultation for your business.</p>
                                            <a href="/contact" class="uzafasta-svc-cta-btn">Contact Us <i class="far fa-arrow-right"></i></a>
                                            <div style="margin-top:14px;">
                                                <a href="#" class="uzafasta-enquiry-btn" data-bs-toggle="modal" data-bs-target="#enquiryModal">Make an Enquiry <i class="far fa-arrow-right"></i></a>
                                            </div>
                                            <div style="margin-top:12px;">
                                                <a href="/track" class="uzafasta-track-link"><i class="far fa-route"></i> Track an existing enquiry</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section><!--======  End Service Details Section  ======-->
                </main>
                                <%- include('../partials/footer') %>
            </div>
        </div>
            <!-- Scroll to Top Button (outside smooth-wrapper) -->
    <button class="uzafasta-scroll-top" id="scrollTopBtn" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <script>
        (function () {
            var btn = document.getElementById('scrollTopBtn');
            if (!btn) return;
            function toggle() {
                if (window.scrollY > 400 || document.documentElement.scrollTop > 400) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
            window.addEventListener('scroll', toggle);
            btn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();
    </script>
<!--====== Jquery js ======-->
        <script src="/assets/js/plugins/jquery-3.7.1.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script src="/assets/js/plugins/popper.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script src="/assets/js/plugins/bootstrap.min.js"></script>
        <!--====== Gsap Js ======-->
        <script src="/assets/js/plugins/gsap/gsap.min.js"></script>
        <script src="/assets/js/plugins/gsap/SplitText.min.js"></script>
        <script src="/assets/js/plugins/gsap/ScrollSmoother.min.js"></script>
        <script src="/assets/js/plugins/gsap/ScrollTrigger.min.js"></script>
        <!--====== Slick js ======-->
        <script src="/assets/js/plugins/slick.min.js"></script>
        <!--====== Magnific js ======-->
        <script src="/assets/js/plugins/jquery.magnific-popup.min.js"></script>
        <!--====== Waypoint js ======-->
        <script src="/assets/js/plugins/jquery.waypoints.js"></script>
        <!--====== CounterUp js ======-->
        <script src="/assets/js/plugins/jquery.counterup.min.js"></script>
        <!--====== Aos js ======-->
        <script src="/assets/js/plugins/aos.js"></script>
        <!--====== Common js ======-->
<script src="/assets/js/theme.js"></script>
    </body>
</html>