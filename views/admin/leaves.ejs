<%- include('partials/head', { pageTitle: 'Leave Management' }) %>
<body>

    <div id="layout-wrapper">

        <%- include('partials/topbar') %>
        <%- include('partials/sidebar') %>

        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">

                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box d-flex align-items-center justify-content-between">
                                <h4 class="mb-0 font-size-18">Leave Management</h4>
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                                        <li class="breadcrumb-item active">Leave Management</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (typeof success !== 'undefined' && success) { %>
                        <%- include('partials/flash') %>
                    <% } %>
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show font-size-14" role="alert">
                            <i class="mdi mdi-alert-circle mr-1"></i> <%= error %>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        </div>
                    <% } %>

                    <div class="row">
                        <div class="col-md-6 col-xl-<%= isSuper ? 4 : 12 %>">
                            <div class="card">
                                <div class="card-body">
                                    <div class="mb-2 d-flex justify-content-between align-items-center">
                                        <h5 class="card-title mb-0">Pending Requests</h5>
                                        <i class="mdi mdi-clock-alert text-warning font-size-24"></i>
                                    </div>
                                    <h2 class="mb-0"><%= pendingTotal %></h2>
                                </div>
                            </div>
                        </div>
                        <% if (isSuper) { %>
                        <div class="col-md-6 col-xl-4">
                            <div class="card">
                                <div class="card-body">
                                    <div class="mb-2 d-flex justify-content-between align-items-center">
                                        <h5 class="card-title mb-0">Approved</h5>
                                        <i class="mdi mdi-checkbox-marked-circle text-success font-size-24"></i>
                                    </div>
                                    <h2 class="mb-0"><%= approvedTotal %></h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-4">
                            <div class="card">
                                <div class="card-body">
                                    <div class="mb-2 d-flex justify-content-between align-items-center">
                                        <h5 class="card-title mb-0">Rejected</h5>
                                        <i class="mdi mdi-close-circle text-danger font-size-24"></i>
                                    </div>
                                    <h2 class="mb-0"><%= rejectedTotal %></h2>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-3"><i class="mdi mdi-calendar-plus mr-1 text-primary"></i> Request Leave</h4>
                                    <form method="POST" action="/admin/leaves/request">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label class="font-weight-bold">Leave Type *</label>
                                                <select class="form-control" name="leave_type" required>
                                                    <% Object.keys(leaveTypeLabel).forEach(function(k) { %>
                                                    <option value="<%= k %>"><%= leaveTypeLabel[k] %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="font-weight-bold">Start Date *</label>
                                                <input type="date" class="form-control" name="start_date" id="leave_start" required>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="font-weight-bold">End Date *</label>
                                                <input type="date" class="form-control" name="end_date" id="leave_end" required>
                                            </div>
                                            <div class="col-md-1 d-flex align-items-end justify-content-center">
                                                <span class="font-size-14 text-muted" id="leave_days"></span>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="font-weight-bold">Reason</label>
                                                <input type="text" class="form-control" name="reason" placeholder="Why are you taking leave?">
                                            </div>
                                            <div class="col-md-1 d-flex align-items-end">
                                                <button type="submit" class="btn btn-primary btn-block waves-effect waves-light"><i class="mdi mdi-send mr-1"></i>Submit</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="card-title mb-0"><i class="mdi mdi-clipboard-text mr-1 text-success"></i> <%= isSuper ? 'All Leave Requests' : 'My Leave Requests' %></h4>
                                        <% if (isSuper) { %><span class="font-size-13 text-muted">Confirm by clicking Approve or Reject.</span><% } %>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-centered table-nowrap mb-0">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <% if (isSuper) { %><th>Staff</th><% } %>
                                                    <th>Leave Type</th>
                                                    <th>Dates</th>
                                                    <th>Days</th>
                                                    <th>Reason</th>
                                                    <th>Status</th>
                                                    <th>Reviewed By</th>
                                                    <th class="text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (leaves.length === 0) { %>
                                                    <tr><td colspan="<%= isSuper ? 9 : 8 %>" class="text-center text-muted">No leave requests yet.</td></tr>
                                                <% } %>
                                                <% leaves.forEach(function(v, i) { %>
                                                <tr>
                                                    <td><%= i + 1 %></td>
                                                    <% if (isSuper) { %>
                                                    <td>
                                                        <strong><%= v.staff_name %></strong>
                                                        <div class="font-size-12 text-muted">@<%= v.staff_username %></div>
                                                    </td>
                                                    <% } %>
                                                    <td><%= leaveTypeLabel[v.leave_type] || v.leave_type %></td>
                                                    <td>
                                                        <%= v.start.toLocaleDateString() %> &rarr; <%= v.end.toLocaleDateString() %>
                                                        <div class="font-size-12 text-muted">Requested <%= v.created_at ? new Date(v.created_at).toLocaleDateString() : '' %></div>
                                                    </td>
                                                    <td><span class="badge badge-soft-dark"><%= v.days %> day<%= v.days > 1 ? 's' : '' %></span></td>
                                                    <td>
                                                        <% if (v.reason) { %><%= v.reason %><% } else { %><span class="text-muted">&mdash;</span><% } %>
                                                    </td>
                                                    <td>
                                                        <span class="badge <%= leaveStatusClass[v.status] %>">
                                                            <% if (v.status === 'approved') { %><i class="mdi mdi-check-circle mr-1"></i><% } %>
                                                            <% if (v.status === 'rejected') { %><i class="mdi mdi-close-circle mr-1"></i><% } %>
                                                            <% if (v.status === 'pending') { %><i class="mdi mdi-clock-outline mr-1"></i><% } %>
                                                            <%= leaveStatusLabel[v.status] %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <% if (v.reviewed_by) { %>
                                                            <%= v.reviewer_name || 'Admin' %>
                                                            <% if (v.reviewed_at) { %><div class="font-size-12 text-muted"><%= v.reviewed_at.toLocaleDateString() %></div><% } %>
                                                        <% } else { %>
                                                            <span class="text-muted">&mdash;</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-right">
                                                        <% if (isSuper && v.status === 'pending') { %>
                                                        <form method="POST" action="/admin/leaves/<%= v.id %>/approve" style="display:inline">
                                                            <button type="submit" class="btn btn-sm btn-success"><i class="mdi mdi-check mr-1"></i>Approve</button>
                                                        </form>
                                                        <form method="POST" action="/admin/leaves/<%= v.id %>/reject" style="display:inline">
                                                            <button type="submit" class="btn btn-sm btn-danger"><i class="mdi mdi-close mr-1"></i>Reject</button>
                                                        </form>
                                                        <% } %>
                                                        <% if (isSuper && v.status !== 'pending') { %>
                                                        <form method="POST" action="/admin/leaves/<%= v.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this leave record?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-delete"></i></button>
                                                        </form>
                                                        <% } %>
                                                        <% if (!isSuper && v.status === 'pending') { %>
                                                        <form method="POST" action="/admin/leaves/<%= v.id %>/delete" style="display:inline" onsubmit="return confirm('Cancel this leave request?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-cancel mr-1"></i>Cancel</button>
                                                        </form>
                                                        <% } %>
                                                        <% if (!isSuper && v.status !== 'pending') { %>
                                                        <span class="text-muted">&mdash;</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="/admin-assets/js/jquery.min.js"></script>
    <script src="/admin-assets/js/bootstrap.bundle.min.js"></script>
    <script src="/admin-assets/js/metismenu.min.js"></script>
    <script src="/admin-assets/js/waves.js"></script>
    <script src="/admin-assets/js/simplebar.min.js"></script>
    <script src="/admin-assets/js/theme.js"></script>
    <script>
        function calcDays() {
            var s = new Date($('#leave_start').val());
            var e = new Date($('#leave_end').val());
            if ($('#leave_start').val() && $('#leave_end').val() && e >= s) {
                var days = Math.round((e - s) / 86400000) + 1;
                $('#leave_days').html('<span class="badge badge-soft-primary">' + days + (days > 1 ? ' days' : ' day') + '</span>');
            } else {
                $('#leave_days').html('');
            }
        }
        $('#leave_start, #leave_end').on('change', calcDays);
    </script>
</body>

</html>